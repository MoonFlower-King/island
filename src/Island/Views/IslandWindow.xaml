<Window x:Class="Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource IslandFont}"
        Foreground="{StaticResource IslandForeground}">

    <!--
      整个窗口是透明的，只有中间的胶囊是实心的。
      分层窗口（AllowsTransparency）里完全透明的像素不接收鼠标，点击会直接落到下面的窗口上。
    -->
    <Grid x:Name="Root">
        <Grid x:Name="CapsuleHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="140" Height="34"
              Cursor="Hand"
              MouseEnter="OnCapsuleMouseEnter"
              MouseLeave="OnCapsuleMouseLeave"
              MouseLeftButtonUp="OnCapsuleClick">

            <Grid.ContextMenu>
                <ContextMenu x:Name="CapsuleMenu" Closed="OnContextMenuClosed">
                    <MenuItem Header="演示：切换紧凑状态" Click="OnDemoToggleCompact" />
                    <MenuItem Header="演示：弹出一条通知" Click="OnDemoNotification" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnExit" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 阴影单独放一层，避免 Effect 影响文字渲染 -->
            <Border x:Name="ShadowLayer"
                    Background="{StaticResource IslandBackground}"
                    CornerRadius="17">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.35" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
            </Border>

            <Border x:Name="Capsule"
                    Background="{StaticResource IslandBackground}"
                    CornerRadius="17"
                    SizeChanged="OnCapsuleSizeChanged">

                <Grid>
                    <!-- 待机：只显示时间 -->
                    <Grid x:Name="IdleView">
                        <TextBlock x:Name="IdleClock"
                                   Text="00:00"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 紧凑：左边指示点，右边信息 -->
                    <Grid x:Name="CompactView" Opacity="0" IsHitTestVisible="False" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="CompactDot" Width="10" Height="10" Fill="#FF30D158"
                                 VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CompactDotScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="10,0"
                                   Text="正在进行的活动"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactClock" Grid.Column="2"
                                   Text="00:00"
                                   FontSize="13"
                                   Foreground="{StaticResource IslandSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 通知：图标 + 标题 + 正文 -->
                    <Grid x:Name="NotificationView" Opacity="0" IsHitTestVisible="False" Margin="14,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#FF0A84FF"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="NotificationIcon" Text="🔔" FontSize="18"
                                       FontFamily="Segoe UI Emoji"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NotificationTitle" Text="通知"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NotificationBody" Text=""
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource IslandSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- 展开：大号时间 + 日期 + 活动区域 -->
                    <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Margin="26,22,26,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ExpandedClock" Text="00:00"
                                           FontSize="40" FontWeight="SemiBold" />
                                <TextBlock x:Name="ExpandedDate" Text=""
                                           FontSize="13"
                                           Foreground="{StaticResource IslandSecondary}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,14,0,0"
                                CornerRadius="14" Background="#1AFFFFFF">
                            <TextBlock x:Name="ExpandedActivity"
                                       Text="暂无正在进行的活动"
                                       FontSize="13"
                                       Foreground="{StaticResource IslandSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
