<Window x:Class="Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:Island.Views.Panels"
        Title="Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource IslandFont}"
        Foreground="{DynamicResource IslandForeground}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <!--
      整个窗口是透明的，只有中间的胶囊是实心的。
      分层窗口（AllowsTransparency）里完全透明的像素不接收鼠标，点击会直接落到下面的窗口上。
    -->
    <Grid x:Name="Root">

        <!--
          顶部热区：鼠标“撞”到屏幕顶端时也能展开（待机时岛只是一条细线，很难精确指到）。
          几乎透明（Alpha=1）但能接收鼠标；只有很窄的一条，不影响下面的窗口。
        -->
        <Border x:Name="HotZone"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="220" Height="6"
                Background="#01000000"
                AllowDrop="True"
                PreviewMouseWheel="OnIslandMouseWheel"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave"
                DragEnter="OnIslandDragOver"
                DragOver="OnIslandDragOver"
                DragLeave="OnIslandDragLeave"
                Drop="OnIslandDrop" />

        <!--
          CapsuleHost 固定为最大尺寸，从不改变布局大小。
          胶囊的形状是一个 RectangleGeometry，由弹簧动画逐帧改它的位置、大小和圆角：
          背景、阴影和内容裁剪共用这一个几何体。这样动画每帧只重绘、不重新布局，才足够顺滑。
          背景没有填充的地方不接收鼠标，所以只有胶囊本身可以点。
        -->
        <Grid x:Name="CapsuleHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              AllowDrop="True"
              MouseEnter="OnIslandMouseEnter"
              MouseLeave="OnIslandMouseLeave"
              MouseLeftButtonUp="OnCapsuleClick"
              PreviewMouseWheel="OnIslandMouseWheel"
              PreviewMouseLeftButtonDown="OnCapsulePreviewMouseDown"
              DragEnter="OnIslandDragOver"
              DragOver="OnIslandDragOver"
              DragLeave="OnIslandDragLeave"
              Drop="OnIslandDrop">

            <Grid.ContextMenu>
                <ContextMenu x:Name="CapsuleMenu" Closed="OnContextMenuClosed">
                    <MenuItem Header="演示：弹出一条通知" Click="OnDemoNotification" />
                    <MenuItem x:Name="PersistClipboardMenu" Header="保存剪贴板历史到磁盘"
                              IsCheckable="True" Click="OnTogglePersistClipboard" />
                    <MenuItem x:Name="LevelHudMenu" Header="显示音量和亮度提示"
                              IsCheckable="True" Click="OnToggleLevelHud" />
                    <MenuItem x:Name="StartupMenu" Header="开机自动启动"
                              IsCheckable="True" Click="OnToggleStartup" />
                    <MenuItem Header="打开数据文件夹" Click="OnOpenDataFolder" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnExit" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 阴影单独放一层，避免 Effect 影响文字渲染 -->
            <Path x:Name="ShadowLayer" Fill="{DynamicResource IslandBackground}">
                <Path.Effect>
                    <DropShadowEffect x:Name="CapsuleShadow" BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.35" Color="Black" RenderingBias="Performance" />
                </Path.Effect>
            </Path>

            <!-- 浅色主题下有一圈细描边，免得浅色胶囊融进浅色背景 -->
            <Path x:Name="CapsuleShape"
                  Fill="{DynamicResource IslandBackground}"
                  Stroke="{DynamicResource IslandOutline}"
                  StrokeThickness="1" />

            <!-- 各状态的内容按各自的最终尺寸摆好，由胶囊形状裁剪出可见部分 -->
            <Grid x:Name="ContentHost">
                    <!-- 待机细线：没有内容 -->
                    <Grid x:Name="LineView" />

                    <!-- 待机：只显示时间 -->
                    <Grid x:Name="IdleView">
                        <TextBlock x:Name="IdleClock"
                                   Text="00:00"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 紧凑（通用）：左边指示点，右边信息。供以后的计时器等模块使用 -->
                    <Grid x:Name="CompactView" Opacity="0" IsHitTestVisible="False" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="CompactDot" Width="10" Height="10" Fill="{DynamicResource IslandGreen}"
                                 VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CompactDotScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="10,0"
                                   Text="正在进行的活动"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactClock" Grid.Column="2"
                                   Text="00:00"
                                   FontSize="13"
                                   Foreground="{DynamicResource IslandSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 紧凑（音乐）：封面 + 歌名 + 律动条 -->
                    <Grid x:Name="MediaCompactView" Opacity="0" IsHitTestVisible="False" Margin="8,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MediaCompactArt" Width="24" Height="24" CornerRadius="7"
                                Background="{DynamicResource IslandSurfaceStrong}" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaCompactArtPlaceholder" Text="&#xE8D6;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource IslandSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="MediaCompactTitle" Grid.Column="1" Margin="10,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <StackPanel x:Name="Equalizer" Grid.Column="2" Orientation="Horizontal"
                                    Height="16" VerticalAlignment="Center">
                            <Rectangle x:Name="EqBar1" Style="{StaticResource EqualizerBar}" Height="16" />
                            <Rectangle x:Name="EqBar2" Style="{StaticResource EqualizerBar}" Height="16" />
                            <Rectangle x:Name="EqBar3" Style="{StaticResource EqualizerBar}" Height="16" />
                            <Rectangle x:Name="EqBar4" Style="{StaticResource EqualizerBar}" Height="16" />
                        </StackPanel>
                    </Grid>

                    <!-- 通知：图标 + 标题 + 正文 -->
                    <Grid x:Name="NotificationView" Opacity="0" IsHitTestVisible="False" Margin="14,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource IslandAccent}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="NotificationIcon" Text="🔔" FontSize="18"
                                       FontFamily="Segoe UI Emoji"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NotificationTitle" Text="通知"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NotificationBody" Text=""
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource IslandSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- 音量 / 亮度提示：图标 + 进度 + 百分比 -->
                    <Grid x:Name="LevelView" Opacity="0" IsHitTestVisible="False" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LevelIcon" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="6" CornerRadius="3" Margin="10,0"
                                Background="{DynamicResource IslandSurfaceStrong}" VerticalAlignment="Center">
                            <!-- 只缩放、不改宽度：变化时只重绘，不触发布局 -->
                            <Border x:Name="LevelFill" CornerRadius="3" Background="{DynamicResource IslandForeground}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LevelFillScale" ScaleX="0.5" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="LevelText" Grid.Column="2" Text="50%" FontSize="12" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 展开：顶部功能标签 + 内容区 -->
                    <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Margin="16,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabMusic" Style="{StaticResource IslandTab}" Content="&#xE8D6;"
                                             Tag="Music" ToolTip="音乐" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabTodo" Style="{StaticResource IslandTab}" Content="&#xE762;"
                                             Tag="Todo" ToolTip="待办" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabClipboard" Style="{StaticResource IslandTab}" Content="&#xE77F;"
                                             Tag="Clipboard" ToolTip="剪贴板历史" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabShelf" Style="{StaticResource IslandTab}" Content="&#xE8B7;"
                                             Tag="Shelf" ToolTip="文件中转站" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabTranslate" Style="{StaticResource IslandTab}" Content="&#xE8C1;"
                                             Tag="Translate" ToolTip="AI 翻译" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabMonitor" Style="{StaticResource IslandTab}" Content="&#xE9D9;"
                                             Tag="Monitor" ToolTip="系统监控" Checked="OnTabChecked" />
                                <RadioButton x:Name="TabAppearance" Style="{StaticResource IslandTab}" Content="&#xE790;"
                                             Tag="Appearance" ToolTip="外观" Checked="OnTabChecked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PinButton" Style="{StaticResource IslandSmallButton}" Content="&#xE718;"
                                        Margin="0,0,6,0" ToolTip="置顶：鼠标移开也保持展开，方便拖文件"
                                        Click="OnTogglePin" />
                                <TextBlock x:Name="ExpandedDate" FontSize="11" Margin="0,0,6,0"
                                           Foreground="{DynamicResource IslandTertiary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExpandedClock" Text="00:00" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PanelHost" Grid.Row="1" Margin="0,10,0,0">

                            <!-- 音乐 -->
                            <Grid x:Name="MusicPanel">
                                <Grid x:Name="MediaPlayer" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="4,6,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MediaExpandedArt" Width="72" Height="72" CornerRadius="14"
                                                Background="{DynamicResource IslandSurfaceStrong}">
                                            <TextBlock x:Name="MediaExpandedArtPlaceholder" Text="&#xE8D6;"
                                                       FontFamily="{StaticResource IconFont}" FontSize="26"
                                                       Foreground="{DynamicResource IslandSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MediaArtist" FontSize="13" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource IslandSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MediaSource" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource IslandTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="MediaTimeline" Grid.Row="1" Margin="4,16,4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="{DynamicResource IslandSurfaceStrong}"
                                                SizeChanged="OnProgressTrackSizeChanged">
                                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                                    CornerRadius="2" Background="{DynamicResource IslandGreen}" />
                                        </Border>
                                        <TextBlock x:Name="MediaPosition" Grid.Row="1" Margin="0,4,0,0"
                                                   FontSize="11" Foreground="{DynamicResource IslandSecondary}"
                                                   HorizontalAlignment="Left" Text="0:00" />
                                        <TextBlock x:Name="MediaDuration" Grid.Row="1" Margin="0,4,0,0"
                                                   FontSize="11" Foreground="{DynamicResource IslandSecondary}"
                                                   HorizontalAlignment="Right" Text="0:00" />
                                    </Grid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button x:Name="PreviousButton" Style="{StaticResource IslandIconButton}"
                                                Content="&#xE892;" ToolTip="上一首" Click="OnPreviousClick" />
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource IslandIconButton}"
                                                Content="&#xE768;" FontSize="20" Width="52" Margin="12,0"
                                                ToolTip="播放/暂停" Click="OnPlayPauseClick" />
                                        <Button x:Name="NextButton" Style="{StaticResource IslandIconButton}"
                                                Content="&#xE893;" ToolTip="下一首" Click="OnNextClick" />
                                    </StackPanel>

                                    <!-- 系统音量：点击或拖动调节，也可以在岛上滚动滚轮 -->
                                    <Grid x:Name="MediaVolumeRow" Grid.Row="3" Margin="4,0,4,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MediaVolumeIcon" Text="&#xE995;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Foreground="{DynamicResource IslandSecondary}"
                                                   VerticalAlignment="Center" />
                                        <Grid x:Name="MediaVolumeTrack" Grid.Column="1" Height="18" Margin="10,0"
                                              Background="Transparent" Cursor="Hand"
                                              MouseLeftButtonDown="OnVolumeTrackMouseDown"
                                              MouseMove="OnVolumeTrackMouseMove"
                                              MouseLeftButtonUp="OnVolumeTrackMouseUp">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource IslandSurfaceStrong}" />
                                            <Border x:Name="MediaVolumeFill" Height="4" CornerRadius="2"
                                                    Background="{DynamicResource IslandSecondary}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="MediaVolumeScale" ScaleX="0.5" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="MediaVolumeText" Grid.Column="2" Text="50%" FontSize="11"
                                                   Foreground="{DynamicResource IslandSecondary}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="MusicEmpty" Style="{StaticResource IslandEmptyText}"
                                           Text="没有正在播放的音乐&#x0a;在任意播放器里放首歌试试" />
                            </Grid>

                            <panels:TodoPanel x:Name="TodoPanel" Visibility="Collapsed" />
                            <panels:ClipboardPanel x:Name="ClipboardPanel" Visibility="Collapsed" />
                            <panels:ShelfPanel x:Name="ShelfPanel" Visibility="Collapsed" />
                            <panels:TranslatePanel x:Name="TranslatePanel" Visibility="Collapsed" />
                            <panels:MonitorPanel x:Name="MonitorPanel" Visibility="Collapsed" />
                            <panels:AppearancePanel x:Name="AppearancePanel" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
