<UserControl x:Class="Island.Views.Panels.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,0,4">
            <TextBlock x:Name="Hint" Text="点击任意一条即可重新复制" FontSize="12"
                       Foreground="{DynamicResource IslandTertiary}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource IslandSmallButton}"
                    Content="&#xE74D;" ToolTip="清空历史" Click="OnClear" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource IslandRow}" Cursor="Hand"
                                MouseLeftButtonUp="OnEntryClick" ToolTip="{Binding Text}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Preview}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="11" Margin="8,0,4,0"
                                           Foreground="{DynamicResource IslandTertiary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                    <Button Style="{StaticResource IslandSmallButton}" Content="&#xE711;"
                                            ToolTip="删除" Click="OnDelete" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Grid.Row="1" Style="{StaticResource IslandEmptyText}"
                   Text="复制的文字会出现在这里" />
    </Grid>
</UserControl>
