<UserControl x:Class="Island.Views.Panels.TranslatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProviderChip" TargetType="RadioButton" BasedOn="{StaticResource IslandSegment}">
            <Setter Property="GroupName" Value="TranslateProvider" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource IslandSecondary}" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource IslandTextBox}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 翻译界面 -->
        <Grid x:Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="Input" Style="{StaticResource IslandTextBox}"
                     Tag="输入要翻译的文字，Enter 翻译，Shift+Enter 换行"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Stretch" Padding="10,6"
                     PreviewKeyDown="OnInputKeyDown" />

            <Grid Grid.Row="1" Margin="0,6">
                <TextBlock x:Name="Status" FontSize="11" Foreground="{DynamicResource IslandTertiary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,150,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IslandSmallButton}" Content="&#xE713;"
                            ToolTip="翻译服务设置" Click="OnOpenSettings" />
                    <Button Style="{StaticResource IslandSmallButton}" Content="&#xE77F;" Margin="2,0,0,0"
                            ToolTip="粘贴剪贴板并翻译" Click="OnPasteAndTranslate" />
                    <Button Style="{StaticResource IslandSmallButton}" Content="&#xE8C8;" Margin="2,0,8,0"
                            ToolTip="复制译文" Click="OnCopyResult" />
                    <Button x:Name="TranslateButton" Style="{StaticResource IslandPillButton}"
                            Content="翻译" Click="OnTranslate" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource IslandSurface}" Padding="8,6">
                <TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource IslandForeground}"
                         SelectionBrush="{DynamicResource IslandAccent}" FontSize="13"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" />
            </Border>
        </Grid>

        <!-- 翻译服务设置：选服务商（自动填格式、地址、模型），或者自定义 -->
        <ScrollViewer x:Name="Settings" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden"
                      Focusable="False">
            <StackPanel>
                <WrapPanel x:Name="ProviderChips" />

                <Grid Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="格式" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FormatAnthropic" Style="{StaticResource IslandSegment}" Height="22"
                                     GroupName="TranslateFormat" Content="Anthropic" Checked="OnFormatChecked" />
                        <RadioButton x:Name="FormatOpenAI" Style="{StaticResource IslandSegment}" Height="22"
                                     GroupName="TranslateFormat" Content="OpenAI 兼容" Checked="OnFormatChecked" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="地址" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BaseUrlInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Tag="留空使用默认地址" TextChanged="OnEndpointChanged" KeyDown="OnSettingsKeyDown" />

                    <TextBlock Grid.Row="2" Text="模型" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModelInput" Style="{StaticResource FieldBox}" Tag="模型名称"
                                 KeyDown="OnSettingsKeyDown" />
                        <TextBlock Grid.Column="1" Text="Key" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" />
                        <TextBox x:Name="KeyInput" Grid.Column="2" Style="{StaticResource FieldBox}"
                                 KeyDown="OnSettingsKeyDown" />
                    </Grid>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="SettingsHint" FontSize="10.5" Margin="0,0,150,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource IslandTertiary}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Style="{StaticResource IslandSmallButton}" Content="&#xE72B;"
                                ToolTip="返回" Click="OnCloseSettings" />
                        <Button x:Name="TestButton" Style="{StaticResource IslandPillButton}" Content="测试"
                                Background="{DynamicResource IslandSurfaceStrong}"
                                Foreground="{DynamicResource IslandForeground}"
                                Margin="2,0,6,0" ToolTip="保存并发一句话试试" Click="OnTest" />
                        <Button Style="{StaticResource IslandPillButton}" Content="保存" Click="OnSave" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
