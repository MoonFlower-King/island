<UserControl x:Class="Island.Views.Panels.TodoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Style="{StaticResource IslandTextBox}" Height="32"
                     Tag="添加待办，回车确认" KeyDown="OnInputKeyDown" />
            <Button Grid.Column="1" Style="{StaticResource IslandSmallButton}" Margin="6,0,0,0"
                    Content="&#xE74D;" ToolTip="清除已完成" Click="OnClearCompleted" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource IslandRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource IslandCheck}" VerticalAlignment="Center"
                                          IsChecked="{Binding Done, Mode=TwoWay}" />
                                <TextBlock x:Name="Text" Grid.Column="1" Margin="10,0" FontSize="13"
                                           Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Style="{StaticResource RowActions}">
                                    <Button Style="{StaticResource IslandSmallButton}" Content="&#xE711;"
                                            ToolTip="删除" Click="OnDelete" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource IslandTertiary}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Grid.Row="1" Style="{StaticResource IslandEmptyText}"
                   Text="今天还没有待办" />
    </Grid>
</UserControl>
